# Chave gratuita: https://api.nasa.gov/ (não commite o .env)
# Usada só pelos scripts de coleta (npm run fetch-data, npm run data:missions); o jogo não chama a API.
NASA_API_KEY=

# Servidor do modo em grupo (docs/servidor-coop.md). Vazio = só modo solo.
# Um wss://… fixo, ou "same-origin" se o próprio servidor coop servir o jogo (a imagem Docker já faz isso).
VITE_COOP_URL=
